doctype html
html(lang="id")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title || 'Login'
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="/css/theme.css")
  body.bg-light
    .container
      .row.justify-content-center.align-items-center(style="min-height:100vh")
        .col-md-5
          .card.shadow-sm
            .card-body.p-4
              h3.text-center.mb-4 Lab Inventory Login
              if error
                .alert.alert-danger= error
              form(method="POST" action="/auth/login")
                input(type="hidden" name="returnTo", value=returnTo || '/')
                .mb-3
                  label.form-label(for="email") Email
                  input.form-control#email(type="email" name="email", value=email || '', required)
                .mb-3
                  label.form-label(for="password") Password
                  input.form-control#password(type="password" name="password", required)
                .form-check.mb-3
                  input.form-check-input#remember(type="checkbox" name="remember" value="1", checked=(typeof remember === 'undefined' ? true : !!remember))
                  label.form-check-label(for="remember") Ingat saya
                .d-grid
                  button.btn.btn-primary(type="submit") Login
