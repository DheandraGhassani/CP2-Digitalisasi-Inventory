extends ../layout

block content
  mixin statusBadge(s)
    - var map = { draft: 'secondary', locked: 'warning', reviewed: 'info', finalized: 'success' }
    span.badge(class='bg-' + (map[s] || 'secondary'))= s

  .d-flex.justify-content-between.align-items-center.mb-3
    h2.mb-0 Draf Pengadaan
    a.btn.btn-primary(href="/procurement/create") + Buat Draf
  if success
    .alert.alert-success= success
  .card
    .card-body.p-0
      table.table.table-hover.align-middle.mb-0
        thead.table-light
          tr
            th Tahun
            th Status
            th Jumlah Item
            th Estimasi Biaya
            th.text-end Aksi
        tbody
          if drafts && drafts.length
            each d in drafts
              tr
                td= d.year
                td: +statusBadge(d.status)
                td= d.item_count
                td Rp #{Number(d.total_cost || 0).toLocaleString('id-ID')}
                td.text-end
                  a.btn.btn-sm.btn-outline-primary(href=`/procurement/${d.id}`) Detail
          else
            tr
              td.text-center.text-muted(colspan="5") Belum ada draf pengadaan.
