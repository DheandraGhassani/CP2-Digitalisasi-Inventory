doctype html
html(lang="id")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= title || 'Lab Inventory System'
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="/css/theme.css")
  body.bg-light
    if user
      nav.navbar.navbar-expand.navbar-dark.bg-dark
        .container
          a.navbar-brand(href="/dashboard") Lab Inventory
          ul.navbar-nav.ms-auto
            li.nav-item
              span.navbar-text.text-light.me-3 #{user.name} (#{user.role_name})
            li.nav-item
              a.btn.btn-sm.btn-outline-light(href="/auth/logout") Logout
    main.container.py-4
      block content
