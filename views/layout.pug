doctype html
html(lang="id")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title || 'Lab Inventory System'
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="/css/theme.css")
  body.bg-light
    - var cp = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : ''
    - function navActive(prefix) { return cp.indexOf(prefix) === 0 ? 'active' : '' }
    if user
      nav.navbar.navbar-expand.navbar-dark.bg-dark
        .container
          a.navbar-brand(href="/auth/dashboard") Lab Inventory
          ul.navbar-nav.me-auto.align-items-center
            li.nav-item
              a.nav-link(href="/auth/dashboard", class=navActive('/auth/dashboard')) Dashboard
            if user.role_name === 'admin'
              li.nav-item
                a.nav-link(href="/users", class=navActive('/users')) Pengguna
              li.nav-item
                a.nav-link(href="/rooms", class=navActive('/rooms')) Ruangan
            if user.role_name === 'kalab'
              li.nav-item
                a.nav-link(href="/procurement", class=navActive('/procurement')) Pengadaan
              li.nav-item
                a.nav-link(href="/assets/inventory", class=navActive('/assets/inventory')) Inventaris
              li.nav-item
                a.nav-link(href="/bhp", class=navActive('/bhp')) Stok BHP
            if user.role_name === 'kaprodi'
              li.nav-item
                a.nav-link(href="/review", class=navActive('/review')) Review Pengadaan
              li.nav-item
                a.nav-link(href="/assets/inventory", class=navActive('/assets/inventory')) Inventaris
              li.nav-item
                a.nav-link(href="/bhp", class=navActive('/bhp')) Stok BHP
            if user.role_name === 'staff_admin'
              li.nav-item
                a.nav-link(href="/assets", class=(cp === '/assets' || cp.indexOf('/assets/items') === 0 ? 'active' : '')) Penerimaan
              li.nav-item
                a.nav-link(href="/assets/inventory", class=navActive('/assets/inventory')) Daftar Inventaris
            if user.role_name === 'staff_lab'
              li.nav-item
                a.nav-link(href="/bhp", class=navActive('/bhp')) Stok BHP
              li.nav-item
                a.nav-link(href="/maintenance", class=navActive('/maintenance')) Maintenance
              li.nav-item
                a.nav-link(href="/assets/inventory", class=navActive('/assets/inventory')) Inventaris
          ul.navbar-nav.ms-auto.align-items-center
            li.nav-item
              span.navbar-text.text-light.me-3 #{user.name} (#{user.role_name})
            li.nav-item
              a.btn.btn-sm.btn-outline-light(href="/auth/logout" onclick="return confirm('Yakin ingin logout?')") Logout
    main.container.py-4
      block content
