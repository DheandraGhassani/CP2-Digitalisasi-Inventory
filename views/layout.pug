doctype html
html(lang="id")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title || 'Lab Inventory System'
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="/css/theme.css")
  body.bg-light
    if user
      nav.navbar.navbar-expand.navbar-dark.bg-dark
        .container
          a.navbar-brand(href="/auth/dashboard") Lab Inventory
          ul.navbar-nav.me-auto.align-items-center
            li.nav-item
              a.nav-link(href="/auth/dashboard") Dashboard
            if user.role_name === 'admin'
              li.nav-item
                a.nav-link(href="/users") Pengguna
              li.nav-item
                a.nav-link(href="/rooms") Ruangan
            if user.role_name === 'kalab'
              li.nav-item
                a.nav-link(href="/procurement") Pengadaan
            if user.role_name === 'kaprodi'
              li.nav-item
                a.nav-link(href="/procurement/review") Review Pengadaan
            if user.role_name === 'staff_admin'
              li.nav-item
                a.nav-link(href="/assets") Inventaris
            if user.role_name === 'staff_lab'
              li.nav-item
                a.nav-link(href="/bhp") Stok BHP
              li.nav-item
                a.nav-link(href="/maintenance") Maintenance
          ul.navbar-nav.ms-auto.align-items-center
            li.nav-item
              span.navbar-text.text-light.me-3 #{user.name} (#{user.role_name})
            li.nav-item
              a.btn.btn-sm.btn-outline-light(href="/auth/logout", onclick="return confirm('Yakin ingin logout?')") Logout
    main.container.py-4
      block content
