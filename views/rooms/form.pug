extends ../layout

block content
  - var v = room || {}
  - var isEdit = !!room
  .d-flex.justify-content-between.align-items-center.mb-3
    h2.mb-0= isEdit ? 'Edit Ruangan' : 'Tambah Ruangan'
    a.btn.btn-outline-secondary(href="/rooms") Kembali
  .card
    .card-body
      form(method="POST", action=isEdit ? `/rooms/${room.id}/edit` : '/rooms/create')
        .mb-3
          label.form-label(for="room_code") Kode Ruangan
          input.form-control#room_code(type="text" name="room_code", value=v.room_code || '', class=(errors && errors.room_code ? 'is-invalid' : ''), required)
          if errors && errors.room_code
            .invalid-feedback= errors.room_code
        .mb-3
          label.form-label(for="room_name") Nama Ruangan
          input.form-control#room_name(type="text" name="room_name", value=v.room_name || '', required)
        .mb-3
          label.form-label(for="capacity") Kapasitas
          input.form-control#capacity(type="number" name="capacity" min="0", value=(v.capacity != null ? v.capacity : ''))
        .mb-3
          label.form-label(for="description") Deskripsi
          textarea.form-control#description(name="description" rows="3")= v.description || ''
        .d-flex.gap-2
          button.btn.btn-primary(type="submit")= isEdit ? 'Simpan' : 'Buat'
          a.btn.btn-light(href="/rooms") Batal
